{
  "name": "spatial-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run copy-maplibre && esbuild src/spatial-panel.ts src/spatial-card.ts --bundle --format=esm --minify --external:*/maplibre-gl-shared.mjs --outdir=../custom_components/spatial/frontend",
    "copy-maplibre": "cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs ../custom_components/spatial/frontend/",
    "watch": "npm run build -- --watch=forever",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@turf/area": "7.4.0",
    "@turf/bearing": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/center": "7.4.0",
    "@turf/destination": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "@turf/rewind": "7.4.0",
    "@turf/transform-translate": "7.4.0",
    "@turf/union": "7.4.0",
    "lit": "3.3.3",
    "maplibre-gl": "6.11.2"
  },
  "devDependencies": {
    "@turf/boolean-clockwise": "7.4.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
