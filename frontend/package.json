{
  "name": "spatial-panel",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && esbuild src/spatial-panel.ts src/spatial-card.ts maplibre-gl-worker=node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs --bundle --splitting --chunk-names=chunks/[name]-[hash] --format=esm --minify --outdir=../custom_components/spatial/frontend",
    "clean": "rm -rf ../custom_components/spatial/frontend/*",
    "watch": "npm run build -- --sourcemap --watch=forever",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdi/js": "7.4.47",
    "@turf/bearing": "7.4.0",
    "@turf/boolean-point-in-polygon": "7.4.0",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "@turf/rewind": "7.4.0",
    "@turf/union": "7.4.0",
    "lit": "3.3.3",
    "maplibre-gl": "6.16.0",
    "polylabel": "2.1.0"
  },
  "devDependencies": {
    "@turf/area": "7.4.0",
    "@turf/boolean-clockwise": "7.4.0",
    "@turf/destination": "7.4.0",
    "@types/polylabel": "2.0.0",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
